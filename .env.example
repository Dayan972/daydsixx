# Copiez ce fichier en .env.local et complétez.

# Clé de l'API Claude. Sans elle, l'assistant tourne en « mode démo » (règles simples, gratuit).
ANTHROPIC_API_KEY=

# Facultatif : forcer le mode de l'agent (claude | demo).
# AGENT_MODE=demo

# Facultatif : modèle utilisé par l'agent (par défaut claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5

# Nom affiché de la plateforme (nom de travail : Vitrine).
NEXT_PUBLIC_BRAND_NAME=Vitrine

# Emplacement de la base SQLite (par défaut ./data/vitrine.db).
# DATABASE_PATH=./data/vitrine.db

# Hôtes de la plateforme, séparés par des virgules. Tout autre hôte est traité
# comme le domaine personnel d'une boutique.
PLATFORM_HOSTS=localhost,127.0.0.1

# Hébergeur affiché dans les mentions légales des boutiques.
# PLATFORM_HOST_NAME=
# PLATFORM_HOST_ADDRESS=
